session_df = build_table(df,mapping_rules,'Sessions')
session_df


groupby_sess = groupby_sessions(session_df)
groupby_sess


save_partitioned_parquet(groupby_sess,'../ga4-clean/sessions-parquet/',['Stream ID','year','month'])


pageview_df = build_table(df,mapping_rules,'Pageviews')
pageview_df


pageview_df.loc[19392,'event_timestamp'] = '2024-10-02 13:14:59.145378'





groupby_pv = groupby_pageview(pageview_df)
groupby_pv


save_partitioned_parquet(groupby_pv,'../ga4-clean/pageviews-parquet/',['stream_id','year','month'])


events_df = build_table(df,mapping_rules,'Events')
events_df


save_partitioned_parquet(events_df,'../ga4-clean/events-parquet/',['stream_id','year','month'])
