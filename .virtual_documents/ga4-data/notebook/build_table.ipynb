import pandas as pd 
import sys
import os
sys.path.append(os.path.abspath('..'))
from Utility.MappingRules import MappingRules
from Utility.BuildTable import build_table,groupby_sessions,groupby_pageview,save_partitioned_parquet



connection = MappingRules(
    host="localhost",
    user="root",
    password="1234",
    database="ga4_db"
)

mapping_rules = connection.build_rules()


df = pd.read_parquet('../ga4-clean/pageview-identifier/analytics291746817/2024/10/events_pageview_identifier.parquet')
df


missing_values = ["nan", "None", "(not set)", "",'(none)']
